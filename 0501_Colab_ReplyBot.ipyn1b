# ==========================================
# 1. 讀取安全環境變數與設定
# ==========================================
from google.colab import userdata
import os

ngrok_authtoken = userdata.get('NGROK_AUTHTOKEN')
line_channel_access_token = userdata.get('f1e9d6cf92a09372bfe54a6778c37328')
line_channel_secret = userdata.get('3CT59Gr1ZAeFA3D5hsFp3kA0vFT_52azmvFFcF5Sh84kP1nGR')
os.environ["GEMINI_API_KEY"] = userdata.get('GEMINI_API_KEY') 

port = 5051

# ==========================================
# 2. 啟動 Ngrok 隧道並自動更新 LINE Webhook
# ==========================================
from pyngrok import ngrok
import requests

# 先清理舊的 ngrok 連線
ngrok.kill()

# 啟動新的隧道
ngrok.set_auth_token(ngrok_authtoken)
tunnel = ngrok.connect(port, name="linebot_tunnel")
webhook_url = tunnel.public_url
print(f"🌍 Ngrok 伺服器網址: {webhook_url}")

def update_line_webhook(webhook_url):
    """將產生的 Ngrok 網址自動同步到 LINE 開發者後台"""
    url = "https://api.line.me/v2/bot/channel/webhook/endpoint"
    headers = {
        "Authorization": f"Bearer {line_channel_access_token}",
        "Content-Type": "application/json"
    }
    data = {"endpoint": webhook_url}
    
    response = requests.put(url, headers=headers, json=data)
    if response.status_code == 200:
        print(f"✅ LINE Webhook URL 已成功自動更新！")
        return True
    else:
        print(f"❌ Webhook 更新失敗：{response.status_code} - {response.text}")
        return False

update_line_webhook(webhook_url)

# ==========================================
# 3. 建立 Flask 伺服器與 Gemini 鸚鵡回覆邏輯
# ==========================================
from flask import Flask, request, abort
from linebot.v3 import WebhookHandler
from linebot.v3.exceptions import InvalidSignatureError
from linebot.v3.messaging import (
    Configuration, ApiClient, MessagingApi, ReplyMessageRequest, TextMessage
)
from linebot.v3.webhooks import MessageEvent, TextMessageContent
from google import genai
from google.genai import types

app = Flask(__name__)
configuration = Configuration(access_token=line_channel_access_token)
handler = WebhookHandler(line_channel_secret)

# 初始化新版 Gemini API 客戶端（會自動抓取 os.environ["GEMINI_API_KEY"]）
client = genai.Client()

@app.route("/", methods=['POST'])
def callback():
    signature = request.headers['X-Line-Signature']
    body = request.get_data(as_text=True)
    
    try:
        handler.handle(body, signature)
    except InvalidSignatureError:
        abort(400)
    return 'OK'

@handler.add(MessageEvent, message=TextMessageContent)
def handle_message(event):
    user_message = event.message.text
    print(f"📩 收到使用者訊息: {user_message}")
    
    try:
        # 使用最新的 gemini-2.0-flash，並下達 System Instruction 逼它玩複製人遊戲
        response = client.models.generate_content(
            model='gemini-2.0-flash',
            contents=user_message,
            config=types.GenerateContentConfig(
                system_instruction="你是一個學人精。無論使用者輸入什麼，你都要用一模一樣的文字回答他。例如使用者說「我是 ann」，你就只能回答「我是 ann」，絕對不要加上任何標點符號或其他贅字。",
                temperature=0.1
            )
        )
        ai_reply = response.text.strip()
    except Exception as e:
        print(f"⚠️ Gemini 呼叫失敗: {e}，改用程式字串複製。")
        ai_reply = user_message

    # 回傳給 LINE
    with ApiClient(configuration) as api_client:
        line_bot_api = MessagingApi(api_client)
        line_bot_api.reply_message_with_http_info(
            ReplyMessageRequest(
                reply_token=event.reply_token,
                # 這裡放兩個一模一樣的 TextMessage 物件，就能在「同一秒鐘連發兩次」！
                messages=[
                    TextMessage(text=ai_reply),
                    TextMessage(text=ai_reply)
                ]
            )
        )
    print(f"📤 已成功連發兩則回覆: {ai_reply}")

# ==========================================
# 4. 運行伺服器
# ==========================================
if __name__ == "__main__":
    # 在 Colab 中運行 Flask
    app.run(port=port)

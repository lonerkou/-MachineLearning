import re
from google.genai import types

def stateless_query(payload):
    # 1. 🔍 自動偵測使用者有沒有輸入「XX字內」或「XX字以內」
    max_chars = None
    match = re.search(r'(\d+)\s*字(?:以)?內', payload)
    if match:
        max_chars = int(match.group(1))
        print(f"📌 偵測到嚴格字數限制：{max_chars} 字以內")

    # 2. 設定給 Gemini 的系統提示詞
    config = types.GenerateContentConfig(
        system_instruction=(
            "你是一個嚴格遵守字數限制的 LINE 助理。請用繁體中文回答。\n"
            "如果使用者指定了字數限制，請用最精簡、不帶廢話的完整句子回答，"
            "絕對不能超過規定字數！"
        ),
        temperature=0.1,  # 💡 降到極低，讓 AI 變得最聽話、不亂發揮
    )
    
    # 3. 呼叫 Gemini 生成初步回答
    response = client.models.generate_content(
        model="gemini-2.5-flash",
        contents=payload,
        config=config
    )
    
    reply_text = response.text.strip()
    
    # 4. 🛡️ 嚴格攔截機制（如果 AI 還是爆字數，由程式自動做第二次修正）
    if max_chars and len(reply_text) > max_chars:
        print(f"⚠️ Gemini 爆字數了 ({len(reply_text)}字)，啟動程式自動修正...")
        
        # 叫 Gemini 重新精簡這句話，並把原本超標的句子丟給它當作參考
        fix_prompt = f"請將以下這句話，精簡壓縮到 {max_chars} 個字以內（包含標點符號），必須保留核心意思：\n{reply_text}"
        
        fixed_response = client.models.generate_content(
            model="gemini-2.5-flash",
            contents=fix_prompt,
            config=config
        )
        reply_text = fixed_response.text.strip()
        
        # 萬一 AI 第二次還是超過，採用終極物理切斷（防禦性防線）
        if len(reply_text) > max_chars:
            reply_text = reply_text[:max_chars-1] + "。"

    return reply_text

from google.genai import types

def stateless_query(payload):
    # 💡 核心：加入 Google Search 作為 AI 的工具
    config = types.GenerateContentConfig(
        system_instruction=(
            "你是一個明新科技大學的智慧助理。請使用台灣繁體中文回答。\n"
            "當使用者詢問學校的即時資訊（如現任校長、最新消息）時，請務必使用搜尋工具確認後再回答。"
        ),
        temperature=0.1,
        # 👇 啟用 Google 搜尋聯網功能
        tools=[{"google_search": {}}] 
    )
    
    response = client.models.generate_content(
        model="gemini-2.5-flash",
        contents=payload,
        config=config
    )
    return response.text
